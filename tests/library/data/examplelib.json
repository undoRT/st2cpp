{
  "$schemaVersion": "1.0",

  "id": "examplelib",
  "name": "ExampleLib",
  "version": "1.0.0",
  "description": "Libreria di esempio che copre tutti i concetti base ST mappati verso C++.",

  "dependencies": [
    {
      "id": "corelib",
      "version": "^1.0.0"
    }
  ],

  "cppBinding": {
    "include": "examplelib/examplelib.hpp",
    "namespace": "examplelib"
  },

  "constants": [
    {
      "name": "MAX_CHANNELS",
      "type": {
        "kind": "primitive",
        "name": "INT"
      },
      "value": 8,
      "cppBinding": {
        "symbol": "kMaxChannels"
      },
      "documentation": "Numero massimo di canali gestiti dalla libreria."
    },
    {
      "name": "DEFAULT_TIMEOUT",
      "type": {
        "kind": "primitive",
        "name": "TIME"
      },
      "value": "T#500ms",
      "documentation": "Timeout predefinito della libreria."
    }
  ],

  "enums": [
    {
      "name": "State",

      "cppBinding": {
        "symbol": "State"
      },

      "baseType": {
        "kind": "primitive",
        "name": "INT"
      },

      "members": [
        { "name": "IDLE", "value": 0 },
        { "name": "RUNNING", "value": 1 },
        { "name": "FAULT", "value": 2 }
      ],

      "initValue": {
        "kind": "scalar",
        "value": "IDLE"
      },

      "documentation": "Stato operativo del sistema."
    }
  ],

  "types": [
    {
      "name": "Channel",
      "kind": "struct",

      "cppBinding": {
        "symbol": "Channel"
      },

      "fields": [
        {
          "name": "Value",
          "type": {
            "kind": "primitive",
            "name": "REAL"
          },
          "initValue": {
            "kind": "scalar",
            "value": 0.0
          }
        },
        {
          "name": "Enabled",
          "type": {
            "kind": "primitive",
            "name": "BOOL"
          },
          "initValue": {
            "kind": "scalar",
            "value": false
          }
        },
        {
          "name": "Status",
          "type": {
            "kind": "named",
            "name": "State"
          },
          "initValue": {
            "kind": "scalar",
            "value": "IDLE"
          }
        },
        {
          "name": "Limits",
          "type": {
            "kind": "named",
            "library": "corelib",
            "name": "Range"
          },
          "documentation": "Tipo definito in un'altra libreria."
        }
      ],

      "documentation": "Rappresenta un singolo canale."
    },
    {
      "name": "ChannelBank",
      "kind": "struct",

      "cppBinding": {
        "symbol": "ChannelBank"
      },

      "fields": [
        {
          "name": "Channels",
          "type": {
            "kind": "array",
            "lowerBound": 0,
            "upperBound": 7,
            "elementType": {
              "kind": "named",
              "name": "Channel"
            }
          },
          "initValue": {
            "kind": "repeat",
            "count": 8,
            "value": {
              "kind": "default"
            }
          }
        }
      ],

      "documentation": "Insieme dei canali disponibili."
    }
  ],

  "globalVariables": [
    {
      "name": "gSystemState",
      "type": {
        "kind": "named",
        "name": "State"
      },
      "scope": "global",
      "constant": false,

      "cppBinding": {
        "symbol": "g_system_state"
      },

      "initValue": {
        "kind": "scalar",
        "value": "IDLE"
      },

      "documentation": "Stato globale corrente del sistema."
    },
    {
      "name": "gChannelBank",
      "type": {
        "kind": "named",
        "name": "ChannelBank"
      },
      "scope": "global",
      "constant": false,

      "cppBinding": {
        "symbol": "g_channel_bank"
      },

      "documentation": "Banco globale dei canali."
    },
    {
      "name": "gCalibration",
      "type": {
        "kind": "array",
        "lowerBound": 0,
        "upperBound": 9,
        "elementType": {
          "kind": "primitive",
          "name": "INT"
        }
      },
      "scope": "global",
      "constant": true,

      "cppBinding": {
        "symbol": "g_calibration"
      },

      "initValue": {
        "kind": "sparse",

        "entries": [
          {
            "range": {
              "lower": 0,
              "upper": 0
            },
            "value": 100
          },
          {
            "range": {
              "lower": 5,
              "upper": 9
            },
            "value": 0
          }
        ],

        "default": 0
      },

      "documentation": "Costante globale, non modificabile a runtime."
    },
    {
      "name": "gRawSamples",
      "type": {
        "kind": "array",
        "lowerBound": 0,
        "upperBound": 3,
        "elementType": {
          "kind": "primitive",
          "name": "INT"
        }
      },
      "scope": "global",
      "constant": false,

      "cppBinding": {
        "symbol": "g_raw_samples"
      },

      "initValue": {
        "kind": "list",
        "values": [
          1,
          2,
          3,
          4
        ]
      },

      "documentation": "Campioni grezzi acquisiti dal sistema."
    }
  ],

  "functions": [
    {
      "name": "Clamp",

      "cppBinding": {
        "symbol": "clamp",
        "kind": "freeFunction"
      },

      "returnType": {
        "kind": "primitive",
        "name": "REAL"
      },

      "parameters": [
        {
          "name": "Value",
          "type": {
            "kind": "primitive",
            "name": "REAL"
          },
          "direction": "IN"
        },
        {
          "name": "Min",
          "type": {
            "kind": "primitive",
            "name": "REAL"
          },
          "direction": "IN",
          "initValue": {
            "kind": "scalar",
            "value": 0.0
          }
        },
        {
          "name": "Max",
          "type": {
            "kind": "primitive",
            "name": "REAL"
          },
          "direction": "IN",
          "initValue": {
            "kind": "scalar",
            "value": 100.0
          }
        }
      ],

      "documentation": "Limita Value all'intervallo compreso tra Min e Max."
    },
    {
      "name": "Normalize",

      "cppBinding": {
        "symbol": "normalize",
        "kind": "staticMethod",
        "owner": "examplelib::MathUtils"
      },

      "returnType": {
        "kind": "primitive",
        "name": "REAL"
      },

      "parameters": [
        {
          "name": "Value",
          "type": {
            "kind": "primitive",
            "name": "REAL"
          },
          "direction": "IN"
        }
      ],

      "documentation": "Esempio di function mappata su un metodo statico C++."
    }
  ],

  "functionBlocks": [
    {
      "name": "TON",

      "cppBinding": {
        "instanceType": "examplelib::TonInstance",
        "call": "process"
      },

      "parameters": [
        {
          "name": "IN",
          "type": {
            "kind": "primitive",
            "name": "BOOL"
          },
          "direction": "IN",
          "initValue": {
            "kind": "scalar",
            "value": false
          }
        },
        {
          "name": "PT",
          "type": {
            "kind": "primitive",
            "name": "TIME"
          },
          "direction": "IN",
          "initValue": {
            "kind": "scalar",
            "value": "T#0s"
          }
        },
        {
          "name": "Q",
          "type": {
            "kind": "primitive",
            "name": "BOOL"
          },
          "direction": "OUT"
        },
        {
          "name": "ET",
          "type": {
            "kind": "primitive",
            "name": "TIME"
          },
          "direction": "OUT"
        }
      ],

      "documentation": "Timer ON-delay compatibile con il modello IEC 61131-3."
    },
    {
      "name": "ChannelReader",

      "cppBinding": {
        "instanceType": "examplelib::ChannelReaderInstance",
        "call": "process"
      },

      "parameters": [
        {
          "name": "Bank",
          "type": {
            "kind": "named",
            "name": "ChannelBank"
          },
          "direction": "IN_OUT"
        },
        {
          "name": "Index",
          "type": {
            "kind": "primitive",
            "name": "INT"
          },
          "direction": "IN"
        },
        {
          "name": "Result",
          "type": {
            "kind": "named",
            "name": "Channel"
          },
          "direction": "OUT"
        },
        {
          "name": "Valid",
          "type": {
            "kind": "primitive",
            "name": "BOOL"
          },
          "direction": "OUT"
        }
      ],

      "documentation": "Esempio di FB con parametro IN_OUT e struct come tipo."
    }
  ]
}